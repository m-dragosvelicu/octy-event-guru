SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EVENT_GURU_HOST_USER_ID=
MAPBOX_ACCESS_TOKEN=
MAPBOX_PERMANENT=true
INGEST_API_TOKEN=
DEFAULT_AREA_ID=

# Optional tuning
INGEST_RUN_REPORT_PATH=ingest_runs.json
MAPBOX_COUNTRY_BIAS=us
MAPBOX_BBOX_BIAS=

# Redis and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Circuit breaker
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=300

# Rate limiting (requests per second)
RATE_LIMIT_WEB_RPS=2.0
RATE_LIMIT_API_RPS=10.0

# Integration test defaults (used by `make stack-up` + `make test-integration`)
# TICKETMASTER_API_KEY=
# PREDICTHQ_API_KEY=
# MEETUP_API_KEY=
